diff --color -ruN a/spice-gtk-0.42/src/spice-nogst.c b/spice-gtk-0.42/src/spice-nogst.c
--- a/spice-gtk-0.42/src/spice-nogst.c	1970-01-01 01:00:00
+++ b/spice-gtk-0.42/src/spice-nogst.c	2026-09-19 01:58:50
@@ -0,0 +1,21 @@
+/* ShadowPcAdvanced: stand-in for channel-display-gst.c and spice-gstaudio.c so
+ * spice-client-glib builds without GStreamer. Video streams fall back to the
+ * built-in MJPEG decoder; other codecs are never advertised to the server. */
+#include "config.h"
+
+#include "spice-client.h"
+#include "spice-common.h"
+#include "spice-channel-priv.h"
+#include "channel-display-priv.h"
+
+G_GNUC_INTERNAL
+VideoDecoder* create_gstreamer_decoder(int codec_type, display_stream *stream)
+{
+    return NULL;
+}
+
+G_GNUC_INTERNAL
+gboolean gstvideo_has_codec(int codec_type)
+{
+    return FALSE;
+}
