+- (instancetype)initWithFileDescriptorProvider:(CSConnectionFileDescriptorProvider)provider {
+    if (self = [super init]) {
+        self.spiceSession = spice_session_new();
+        self.fileDescriptorProvider = provider;
+        g_object_set(self.spiceSession,
+                     "enable-audio", FALSE,
