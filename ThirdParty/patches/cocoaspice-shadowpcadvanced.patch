 - (BOOL)connect {
+    if (self.fileDescriptorProvider) {
+        // fd = -1: every channel asks for its transport through "open-fd".
+        // SPICE owns its thread; never start a session from the caller's.
+        SpiceSession *session = self.spiceSession;
+        g_object_ref(session);
+        [CSMain.sharedInstance asyncWith:^{
+            spice_session_open_fd(session, -1);
+            g_object_unref(session);
+        }];
+        return YES;
+    }
     return spice_session_connect(self.spiceSession);
 }
 
 - (void)disconnect {
+    if (self.fileDescriptorProvider) {
+        SpiceSession *session = self.spiceSession;
+        g_object_ref(session);
+        [CSMain.sharedInstance asyncWith:^{
+            spice_session_disconnect(session);
+            g_object_unref(session);
+        }];
+        return;
+    }
     spice_session_disconnect(self.spiceSession);
 }
 
